{
  "name": "logistics-pro",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Logistics Pro: one integration hub and one app for shippers, 3PLs, carriers and truckers.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "i18n": "tsx packages/workspace/scripts/i18n.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:mobile": "npm run typecheck --workspace @logisticspro/mobile",
    "dev:api": "npm run dev --workspace @logisticspro/api",
    "start:api": "npm run start --workspace @logisticspro/api",
    "dev:mobile": "npm run start --workspace @logisticspro/mobile",
    "build:web": "npm run build:web --workspace @logisticspro/mobile",
    "serve": "npm run build:web && LP_WEB_DIR=$PWD/dist/web npm run start:api",
    "test:e2e": "playwright test",
    "test:eld-live": "vitest run apps/api/test/eld.live.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@types/node": "^26.6.4",
    "@types/node-forge": "^1.3.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
