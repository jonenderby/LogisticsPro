# API server
PORT=8080
LP_JWT_SECRET=change-me-to-a-long-random-string
LP_ACCESS_TTL=1h
LP_REFRESH_DAYS=30
# EDI for AS2/SFTP/VAN partners is written here for your EDI gateway to pick up
LP_EDI_OUTBOX=./var/edi-outbox
LP_EDI_SENDER_ID=LOGISTICSPRO
# Website: serve the built site (npm run build:web) from the API at "/"
# LP_WEB_DIR=./dist/web
# Extra origins allowed to use the browser session cookie (e.g. the Expo dev server)
# LP_WEB_ORIGINS=http://localhost:8081
# Session cookie is Secure (HTTPS only) by default when NODE_ENV=production
# LP_COOKIE_SECURE=true

# People who run this deployment (comma-separated emails). They see More >
# Setup status in the app: what is connected and what is missing.
# LP_ADMIN_EMAILS=ops@example.com

# Public address of this server (used for the AS2 URL shown to partners)
# It can include a path when the domain is shared with another site
# (https://example.com/logistics): the website, links and cookies follow it.
# Build the website with EXPO_PUBLIC_BASE_PATH set to that path (the Docker
# image does this from LP_PUBLIC_URL).
# LP_PUBLIC_URL=https://api.logisticspro.example

# Postgres. Without it, data lives in memory and is lost on restart.
# Several API servers can share one database: set the same LP_JWT_SECRET on
# each; they stay in step and only one runs background jobs.
# LP_DATABASE_URL=postgres://logisticspro:change-me@localhost:5432/logisticspro

# Carrier vetting against FMCSA. Get a free web key at
# https://mobile.fmcsa.dot.gov/QCDevsite. Without it, carriers are not checked
# and nothing is blocked. LP_FMCSA_FIXTURES can point at a JSON array of
# records instead, for demos and staging.
# LP_FMCSA_WEBKEY=
# LP_FMCSA_FIXTURES=./fmcsa-fixtures.json

# Finished loads untouched this many days leave memory (they stay in Postgres,
# come back when opened and are searchable under Older loads). 0 keeps all.
# LP_ARCHIVE_AFTER_DAYS=120
# LP_ARCHIVE_TRANSMISSIONS_AFTER_DAYS=30

# Uploaded documents (scans, PDFs, signed receipts) are stored in Postgres when
# LP_DATABASE_URL is set. Without a database, set a directory to keep them.
# LP_FILES_DIR=./var/files

# Phone app builds offered at /download. deploy/build-android.sh puts the
# Android APK here; an iPhone ad hoc build (logistics-pro.ipa) can go here too.
# LP_DOWNLOADS_DIR=./deploy/downloads

# The privacy policy at /privacy names who runs this server and where people
# ask for their data or for their account to be deleted (defaults to the first
# LP_ADMIN_EMAILS address). App stores link to it.
# LP_OPERATOR_NAME=Acme Freight LLC
# LP_PRIVACY_CONTACT=privacy@example.com

# Key for encrypting credentials businesses enter (ELD API keys). Defaults to
# LP_JWT_SECRET; set it separately so rotating the session secret doesn't
# lose the ELD connections.
# LP_DATA_KEY=

# Truck routing (Valhalla). Without it, routes are straight lines between stops.
# LP_VALHALLA_URL=http://localhost:8002
# Live traffic for ETAs: here or tomtom, with its API key. Moving loads are
# routed with traffic every 15 minutes; Valhalla is the fallback.
# LP_TRAFFIC=here
# LP_TRAFFIC_KEY=
# Address search: nominatim or pelias
# LP_GEOCODER=nominatim
# LP_GEOCODER_URL=http://localhost:8081
# LP_GEOCODER_KEY=        # for hosted Pelias services

# Central AS2 station. Without key/cert PEMs, one is generated and kept in LP_AS2_DIR.
# LP_AS2_ID=LOGISTICSPRO
# LP_AS2_DIR=./var/as2
# LP_AS2_KEY_PEM=
# LP_AS2_CERT_PEM=

# Carrier join codes rotate after this many hours (default 7 days)
# LP_JOIN_CODE_TTL_HOURS=168

# Partner credentials are referenced by name from partner profiles and
# resolved from LP_SECRET_<NAME>. Example for secretRef "estes_api_key":
# LP_SECRET_ESTES_API_KEY=...

# Phone apps (the website defaults to its own origin)
EXPO_PUBLIC_API_URL=http://localhost:8080
# GOOGLE_MAPS_ANDROID_API_KEY=...

# Arrival alerts. Phones get push through Expo's push service; "off" keeps
# alerts in the in-app inbox only. The checker runs every N seconds (0 = off).
# LP_PUSH=expo
# LP_EXPO_ACCESS_TOKEN=     # only if enhanced push security is on in Expo
# LP_ALERT_INTERVAL_SECONDS=60

# Website map tiles for tracking. The default OpenStreetMap tiles are for
# development only; their usage policy forbids heavy production use.
# EXPO_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=&copy; Your tile provider
